<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProjectGuid>{FB9E7E6B-B19F-4F37-A708-2996190CEF13}</ProjectGuid>
        <OutputType>library</OutputType>
        <TargetFrameworks>net9.0-windows;net10.0-windows</TargetFrameworks>
        <UseWindowsForms>true</UseWindowsForms>
        <UseWpf>true</UseWpf>
        <RootNamespace>AutoUpdaterDotNET</RootNamespace>
        <AssemblyTitle>AutoUpdater.NET</AssemblyTitle>
        <Company>RBSoft &amp; Cauca</Company>
        <Product>Cauca.AutoUpdater</Product>
        <Copyright>Copyright © 2012-2021 RBSoft</Copyright>
        <Version>1.7.7</Version>
        <AssemblyVersion>1.7.7.0</AssemblyVersion>
        <FileVersion>1.7.7.0</FileVersion>
        <PackageVersion>1.7.7</PackageVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageId>Cauca.AutoUpdater</PackageId>
        <IncludeSymbols>true</IncludeSymbols>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Title>AutoUpdater.NET</Title>
        <Authors>rbsoft</Authors>
        <Description>Fully based on AutoUpdater.Net</Description>
        <PackageProjectUrl>https://github.com/iamkinetic/AutoUpdater.NET</PackageProjectUrl>
        <PackageTags>autoupdate updater c# vb wpf winforms</PackageTags>
        <PackageReleaseNotes>https://github.com/ravibpatel/AutoUpdater.NET/releases</PackageReleaseNotes>
        <PackageOutputPath>build</PackageOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>build\lib</OutputPath>
        <DebugType>pdbonly</DebugType>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <DocumentationFile>build\lib\AutoUpdater.NET.xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="semver" Version="2.3.0" />
    </ItemGroup>

    <!-- Runs once, in the outer build of this project, before the per-framework builds that all embed the same
         Resources\ZipExtractor.exe. Skipped in solution builds, which embed the committed executable: the projects that
         reference this one would otherwise build while the executable is deleted and being republished. The single-file
         publish skips an output newer than its inputs, so the old executable is deleted first. -->
    <Target Name="PublishZipExtractor" BeforeTargets="DispatchToInnerBuilds" Condition=" '$(Configuration)' == 'Release' And '$(BuildingSolutionFile)' != 'true' ">
        <Message Text="Publishing ZipExtractor to Resources..." Importance="High" />
        <Delete Files="$(MSBuildThisFileDirectory)Resources\ZipExtractor.exe" />
        <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\ZipExtractor\ZipExtractor.csproj&quot; --configuration Release --framework net10.0-windows -r win-x86 /p:SelfContained=false /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true --output &quot;$(MSBuildThisFileDirectory)Resources&quot;" />
    </Target>
</Project>